# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.
# Next loads .env automatically; on Hostinger, set these in hPanel instead.

# Port. Hostinger sets this automatically; 3000 is the local default.
PORT=3000

# --- Contact form email ----------------------------------------------------

# Where contact form submissions are delivered.
MAIL_TO=stronghold@strongholdlockurity.com

# The From address on outgoing mail. Must be a mailbox on your own domain,
# created in hPanel > Emails, or the mail will be treated as spam.
MAIL_FROM=no-reply@strongholdlockurity.com

# Hostinger's outgoing mail server. Use the mailbox address and its password
# as the SMTP credentials — not your hPanel login.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@strongholdlockurity.com
SMTP_PASS=

# --- Contact form storage (Supabase) ---------------------------------------

# Project "StrongHold Lockurity Backend". Submissions are written to the
# contact_submissions table before the email is sent, so an SMTP failure
# cannot lose an enquiry.
SUPABASE_URL=https://qxyxwbfhfbiydumlsvti.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row-level security, so
# it is server-only: never prefix it with NEXT_PUBLIC_ and never paste it into
# client code. Copy it from
#   Supabase dashboard > Project settings > API keys > service_role
# If this is left blank the form still works and still emails — it just
# stores nothing.
SUPABASE_SERVICE_ROLE_KEY=
