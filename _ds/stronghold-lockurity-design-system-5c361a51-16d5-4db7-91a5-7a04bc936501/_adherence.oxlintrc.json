{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/examples/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/console/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShellRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|badge|active|key|ref|className|style|children)$/]",
        "message": "<AppShellRow> doesn't accept that prop. Declared props: icon, label, badge, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|hint|key|ref|className|style|children)$/]",
        "message": "<AuthField> doesn't accept that prop. Declared props: label, type, placeholder, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|disabled|iconLeft|iconRight|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, disabled, iconLeft, iconRight, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:emphasized|featured|glow|padding|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: emphasized, featured, glow, padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|children|key|ref|className|style|children)$/]",
        "message": "<CodeChip> doesn't accept that prop. Declared props: accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeMockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:filename|code|lines|showCopy|key|ref|className|style|children)$/]",
        "message": "<CodeMockup> doesn't accept that prop. Declared props: filename, code, lines, showCopy."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|lead|align|children|key|ref|className|style|children)$/]",
        "message": "<ContentBand> doesn't accept that prop. Declared props: eyebrow, headline, lead, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<ContentBand> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashedRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|key|ref|className|style|children)$/]",
        "message": "<DashedRule> doesn't accept that prop. Declared props: vertical."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|mono|align|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, mono, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|caption|action|glyph|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, caption, action, glyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mono|large)$/]",
        "message": "<Eyebrow> size must be one of 'mono' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreenDividerBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<GreenDividerBand> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|lead|actions|aside|note|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, headline, lead, actions, aside, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='IncludedSummaryGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<IncludedSummaryGroup> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actions|onClose|children|key|ref|className|style|children)$/]",
        "message": "<ModalCard> doesn't accept that prop. Declared props: title, description, actions, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|actions|sticky|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, links, actions, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<PillTag> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|live)$/]",
        "message": "<PillTag> tone must be one of 'default' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|period|blurb|features|cta|badge|featured|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: name, price, period, blurb, features, cta, badge, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscriptionLineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|amount|key|ref|className|style|children)$/]",
        "message": "<SubscriptionLineItem> doesn't accept that prop. Declared props: label, meta, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|success|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, invalid, success."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|tone|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: title, message, tone, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|neutral)$/]",
        "message": "<Toast> tone must be one of 'success' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
